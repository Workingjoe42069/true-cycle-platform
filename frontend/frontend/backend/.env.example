# Postgres connection string
DATABASE_URL=postgres://tcc_user:changeme@localhost:5432/true_cycle

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-random-64-char-hex-string

# Exact origin(s) your frontend is served from, comma-separated.
# Cookies won't work cross-origin unless this matches exactly (scheme + host + port).
FRONTEND_ORIGIN=http://localhost:5500

# production enables secure (HTTPS-only) cookies -- do NOT set this in dev over http
NODE_ENV=development

PORT=4000

# Google Workspace SMTP (for password reset emails)
# SMTP_USER is the full Workspace address that sends the mail, e.g. noreply@truecyclecoaching.com
# SMTP_PASS must be a 16-character Google "App Password" -- NOT your normal login password.
# Generate one at https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled
# on that Workspace account). Google Workspace admin may need to allow this per org policy.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@truecyclecoaching.com
SMTP_PASS=replace-with-a-16-char-app-password
SMTP_FROM=noreply@truecyclecoaching.com

